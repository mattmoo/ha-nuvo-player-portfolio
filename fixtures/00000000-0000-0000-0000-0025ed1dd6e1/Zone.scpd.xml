<?xml version="1.0" encoding="utf-8"?>
<scpd xmlns="urn:schemas-upnp-org:service-1-0">
	<specVersion>
		<major>1</major>
		<minor>0</minor>
	</specVersion>
	<actionList>
		<action>
			<name>Get</name>
			<argumentList>
				<argument>
					<name>FirmwareVersion</name>
					<direction>out</direction>
					<relatedStateVariable>FirmwareVersion</relatedStateVariable>
				</argument>
				<argument>
					<name>SystemID</name>
					<direction>out</direction>
					<relatedStateVariable>SystemID</relatedStateVariable>
				</argument>
				<argument>
					<name>MemberID</name>
					<direction>out</direction>
					<relatedStateVariable>MemberID</relatedStateVariable>
				</argument>
				<argument>
					<name>Title</name>
					<direction>out</direction>
					<relatedStateVariable>Title</relatedStateVariable>
				</argument>
				<argument>
					<name>Icon</name>
					<direction>out</direction>
					<relatedStateVariable>Icon</relatedStateVariable>
				</argument>
				<argument>
					<name>Active</name>
					<direction>out</direction>
					<relatedStateVariable>Active</relatedStateVariable>
				</argument>
				<argument>
					<name>Connecting</name>
					<direction>out</direction>
					<relatedStateVariable>Connecting</relatedStateVariable>
				</argument>
				<argument>
					<name>MasterGroup</name>
					<direction>out</direction>
					<relatedStateVariable>MasterGroup</relatedStateVariable>
				</argument>
				<argument>
					<name>MemberGroup</name>
					<direction>out</direction>
					<relatedStateVariable>MemberGroup</relatedStateVariable>
				</argument>
				<argument>
					<name>Model</name>
					<direction>out</direction>
					<relatedStateVariable>Model</relatedStateVariable>
				</argument>
				<argument>
					<name>AudioInput</name>
					<direction>out</direction>
					<relatedStateVariable>AudioInput</relatedStateVariable>
				</argument>
				<argument>
					<name>PowerState</name>
					<direction>out</direction>
					<relatedStateVariable>PowerState</relatedStateVariable>
				</argument>
			</argumentList>
		</action>
		<action>
			<name>GetActive</name>
			<argumentList>
				<argument>
					<name>Active</name>
					<direction>out</direction>
					<relatedStateVariable>Active</relatedStateVariable>
				</argument>
			</argumentList>
		</action>
		<action>
			<name>GetConnecting</name>
			<argumentList>
				<argument>
					<name>Connecting</name>
					<direction>out</direction>
					<relatedStateVariable>Connecting</relatedStateVariable>
				</argument>
			</argumentList>
		</action>
		<action>
			<name>GetUpdateState</name>
			<argumentList>
				<argument>
					<name>UpdateState</name>
					<direction>out</direction>
					<relatedStateVariable>UpdateState</relatedStateVariable>
				</argument>
			</argumentList>
		</action>
		<action>
			<name>GetFirmwareVersion</name>
			<argumentList>
				<argument>
					<name>FirmwareVersion</name>
					<direction>out</direction>
					<relatedStateVariable>FirmwareVersion</relatedStateVariable>
				</argument>
			</argumentList>
		</action>
		<action>
			<name>GetMemberID</name>
			<argumentList>
				<argument>
					<name>MemberID</name>
					<direction>out</direction>
					<relatedStateVariable>MemberID</relatedStateVariable>
				</argument>
			</argumentList>
		</action>
		<action>
			<name>GetSystemID</name>
			<argumentList>
				<argument>
					<name>SystemID</name>
					<direction>out</direction>
					<relatedStateVariable>SystemID</relatedStateVariable>
				</argument>
			</argumentList>
		</action>
		<action>
			<name>GroupCreate</name>
			<argumentList>
				<argument>
					<name>memberIDs</name>
					<direction>in</direction>
					<relatedStateVariable>JSON</relatedStateVariable>
				</argument>
				<argument>
					<name>groupID</name>
					<direction>out</direction>
					<relatedStateVariable>GroupID</relatedStateVariable>
				</argument>
			</argumentList>
		</action>
		<action>
			<name>GroupDisband</name>
			<argumentList>
				<argument>
					<name>groupID</name>
					<direction>in</direction>
					<relatedStateVariable>GroupID</relatedStateVariable>
				</argument>
			</argumentList>
		</action>
		<action>
			<name>GroupMemberSetGroup</name>
			<argumentList>
				<argument>
					<name>memberIDs</name>
					<direction>in</direction>
					<relatedStateVariable>JSON</relatedStateVariable>
				</argument>
				<argument>
					<name>groupID</name>
					<direction>in</direction>
					<relatedStateVariable>GroupID</relatedStateVariable>
				</argument>
			</argumentList>
		</action>
		<action>
			<name>SystemCreate</name>
			<argumentList>
				<argument>
					<name>primaryGwMac</name>
					<direction>in</direction>
					<relatedStateVariable>PrimaryGwMac</relatedStateVariable>
				</argument>
				<argument>
					<name>newSystemID</name>
					<direction>out</direction>
					<relatedStateVariable>SystemID</relatedStateVariable>
				</argument>
			</argumentList>
		</action>
		<action>
			<name>SystemJoin</name>
			<argumentList>
				<argument>
					<name>systemID</name>
					<direction>in</direction>
					<relatedStateVariable>SystemID</relatedStateVariable>
				</argument>
				<argument>
					<name>newSystemID</name>
					<direction>out</direction>
					<relatedStateVariable>SystemID</relatedStateVariable>
				</argument>
			</argumentList>
		</action>
		<action>
			<name>SystemConfigureGWs</name>
			<argumentList>
				<argument>
					<name>gateways</name>
					<direction>in</direction>
					<relatedStateVariable>JSON</relatedStateVariable>
				</argument>
			</argumentList>
		</action>
		<action>
			<name>RestoreFactoryDefaults</name>
			<argumentList>
				<!-- gupnp-universal-cp doesn't like actions without params - so add a dummy one -->
				<argument>
					<name>dummy</name>
					<direction>in</direction>
					<relatedStateVariable>JSON</relatedStateVariable>
				</argument>
			</argumentList>
		</action>
		<action>
			<name>UserTap</name>
			<argumentList>
				<!-- Output groupID is only non-empty when action result in a new group being created -->
				<argument>
					<name>groupID</name>
					<direction>out</direction>
					<relatedStateVariable>GroupID</relatedStateVariable>
				</argument>
			</argumentList>
		</action>
		<action>
			<name>UserDoubleTap</name>
			<argumentList>
				<!-- Output groupID is only non-empty when action result in a new group being created -->
				<argument>
					<name>groupID</name>
					<direction>out</direction>
					<relatedStateVariable>GroupID</relatedStateVariable>
				</argument>
			</argumentList>
		</action>
	</actionList>
	<serviceStateTable>
		<stateVariable sendEvents="no">
			<name>JSON</name><!-- argument type -->
			<dataType>string</dataType>
		</stateVariable>
		<stateVariable sendEvents="no">
			<name>GroupID</name><!-- argument type -->
			<dataType>string</dataType>
		</stateVariable>
		<stateVariable sendEvents="no">
			<name>PrimaryGwMac</name><!-- argument type -->
			<dataType>string</dataType>
		</stateVariable>
		<stateVariable sendEvents="yes">
			<name>FirmwareVersion</name>
			<dataType>string</dataType>
		</stateVariable>
		<stateVariable sendEvents="yes">
			<name>APIVersion</name>
			<dataType>string</dataType>
		</stateVariable>
		<stateVariable sendEvents="yes">
			<name>SystemID</name>
			<dataType>string</dataType>
		</stateVariable>
		<stateVariable sendEvents="yes">
			<name>MemberID</name>
			<dataType>string</dataType>
		</stateVariable>
		<stateVariable sendEvents="yes">
			<name>Title</name>
			<dataType>string</dataType>
		</stateVariable>
		<stateVariable sendEvents="yes">
			<name>Icon</name>
			<dataType>string</dataType>
		</stateVariable>
		<stateVariable sendEvents="yes">
			<name>HttpPort</name>
			<dataType>ui2</dataType>
			<allowedValueRange>
				<minimum>1</minimum>
				<maximum>65535</maximum>
				<step>1</step>
			</allowedValueRange>
		</stateVariable>
		<stateVariable sendEvents="yes">
			<name>Active</name>
			<dataType>boolean</dataType>
		</stateVariable>
		<stateVariable sendEvents="yes">
			<name>Connecting</name>
			<dataType>boolean</dataType>
		</stateVariable>
		<stateVariable sendEvents="yes">
			<name>UpdateState</name>
			<dataType>string</dataType>
		</stateVariable>
		<stateVariable sendEvents="yes">
			<name>MasterGroup</name>
			<dataType>string</dataType>
		</stateVariable>
		<stateVariable sendEvents="yes">
			<name>MemberGroup</name>
			<dataType>string</dataType>
		</stateVariable>
		<stateVariable sendEvents="yes">
			<name>UpdateURL</name>
			<dataType>string</dataType>
		</stateVariable>
		<stateVariable sendEvents="yes">
			<name>WirelessSupported</name>
			<dataType>boolean</dataType>
		</stateVariable>
		<stateVariable sendEvents="yes">
			<name>Language</name>
			<dataType>string</dataType>
			<defaultValue>en-US</defaultValue>
			<allowedValueList>
				<allowedValue>en-US</allowedValue>
				<allowedValue>fr-FR</allowedValue>
				<allowedValue>it-IT</allowedValue>
				<allowedValue>de-DE</allowedValue>
				<allowedValue>es-ES</allowedValue>
				<allowedValue>pt-PT</allowedValue>
			</allowedValueList>
		</stateVariable>
		<stateVariable sendEvents="yes">
			<name>Model</name>
			<dataType>string</dataType>
		</stateVariable>
		<stateVariable sendEvents="yes">
			<name>AudioInput</name>
			<dataType>string</dataType>
			<defaultValue>player</defaultValue>
			<allowedValueList>
				<allowedValue>player</allowedValue>
				<allowedValue>toslink</allowedValue>
				<allowedValue>rca</allowedValue>
			</allowedValueList>
		</stateVariable>
		<stateVariable sendEvents="yes">
			<name>PowerState</name>
			<dataType>string</dataType>
			<defaultValue>standby</defaultValue>
			<allowedValueList>
				<allowedValue>standby</allowedValue>
				<allowedValue>active</allowedValue>
				<allowedValue>learning</allowedValue>
			</allowedValueList>
		</stateVariable>
		<stateVariable sendEvents="yes">
			<name>CompatibleDevices</name>
			<dataType>string</dataType>
		</stateVariable>
	</serviceStateTable>
</scpd>
